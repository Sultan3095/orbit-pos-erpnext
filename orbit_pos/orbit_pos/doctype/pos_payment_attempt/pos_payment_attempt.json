{
 "doctype": "DocType",
 "name": "POS Payment Attempt",
 "module": "Orbit POS",
 "custom": 0,
 "issingle": 0,
 "istable": 0,
 "engine": "InnoDB",
 "autoname": "PAY-.#####",
 "sort_field": "creation",
 "sort_order": "DESC",
 "track_changes": 1,
 "fields": [
  {"fieldname": "provider", "fieldtype": "Select", "label": "Provider", "options": "paymob\nfawry", "reqd": 1, "in_list_view": 1},
  {"fieldname": "txn_id", "fieldtype": "Data", "label": "POS Transaction", "reqd": 1, "in_list_view": 1},
  {"fieldname": "shift", "fieldtype": "Link", "label": "Shift", "options": "POS Shift"},
  {"fieldname": "amount", "fieldtype": "Currency", "label": "Amount", "reqd": 1, "in_list_view": 1},
  {"fieldname": "currency", "fieldtype": "Data", "label": "Currency", "default": "EGP"},
  {"fieldname": "state", "fieldtype": "Select", "label": "State", "options": "pending\npaid\nfailed\nexpired\nrefunded", "default": "pending", "in_list_view": 1},
  {"fieldname": "provider_ref", "fieldtype": "Data", "label": "Provider Reference", "in_list_view": 1},
  {"fieldname": "mode", "fieldtype": "Data", "label": "Mode", "default": "mock"},
  {"fieldname": "instructions", "fieldtype": "Small Text", "label": "Customer Instructions"},
  {"fieldname": "checkout_url", "fieldtype": "Data", "label": "Checkout URL"},
  {"fieldname": "request_json", "fieldtype": "Code", "label": "Request"},
  {"fieldname": "response_json", "fieldtype": "Code", "label": "Response"},
  {"fieldname": "sales_invoice", "fieldtype": "Link", "label": "Sales Invoice", "options": "Sales Invoice"}
 ],
 "permissions": [
  {"role": "POS Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
  {"role": "POS User", "read": 1, "write": 1, "create": 1, "report": 1},
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
 ]
}
