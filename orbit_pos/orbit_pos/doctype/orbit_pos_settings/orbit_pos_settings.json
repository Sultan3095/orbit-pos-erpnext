{
 "doctype": "DocType",
 "name": "Orbit POS Settings",
 "module": "Orbit POS",
 "custom": 0,
 "issingle": 1,
 "istable": 0,
 "editable_grid": 0,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "return_window_days",
   "fieldtype": "Int",
   "label": "Exchange / Return Window (days)",
   "default": "14",
   "description": "Printed on exchange receipts. 0 = no limit. After the window a manager PIN is needed."
  },
  {
   "fieldname": "allow_cross_branch_returns",
   "fieldtype": "Check",
   "label": "Allow Cross Branch Returns",
   "default": "0"
  },
  {
   "fieldname": "cashier_max_discount_percent",
   "fieldtype": "Percent",
   "label": "Cashier Max Discount Percent",
   "default": "10"
  },
  {
   "fieldname": "cashier_cash_out_limit",
   "fieldtype": "Currency",
   "label": "Cashier Cash Out Limit",
   "default": "200",
   "description": "A cashier cash-out above this amount needs a manager PIN"
  },
  {
   "fieldname": "currency_per_point",
   "fieldtype": "Currency",
   "label": "Currency Per Point",
   "default": "10"
  },
  {
   "fieldname": "value_per_point",
   "fieldtype": "Currency",
   "label": "Value Per Point",
   "default": "0.5"
  },
  {
   "fieldname": "barcode_prefix",
   "fieldtype": "Data",
   "label": "Barcode Prefix",
   "default": "200"
  },
  {
   "fieldname": "barcode_seq",
   "fieldtype": "Int",
   "label": "Barcode Seq",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "receipt_language",
   "fieldtype": "Select",
   "label": "Receipt Language",
   "options": "ar\nen",
   "default": "ar"
  },
  {
   "fieldname": "ui_language",
   "fieldtype": "Select",
   "label": "Ui Language",
   "options": "ar\nen",
   "default": "ar"
  },
  {
   "fieldname": "default_theme",
   "fieldtype": "Select",
   "label": "Default Theme",
   "options": "light\ndark\nblue",
   "default": "light"
  },
  {
   "fieldname": "eta_enabled",
   "fieldtype": "Check",
   "label": "Eta Enabled",
   "default": "0"
  },
  {
   "fieldname": "eta_environment",
   "fieldtype": "Select",
   "label": "Eta Environment",
   "options": "Preprod\nProd",
   "default": "Preprod"
  },
  {
   "fieldname": "eta_note",
   "fieldtype": "Small Text",
   "label": "Eta Note",
   "read_only": 1,
   "default": "ETA credentials are never stored here in plain text. Use a vault/secret."
  },
  {
   "fieldname": "terms_section",
   "fieldtype": "Section Break",
   "label": "Receipt Terms & Conditions"
  },
  {
   "fieldname": "receipt_terms_ar",
   "fieldtype": "Small Text",
   "label": "Terms (Arabic)",
   "description": "Printed at the bottom of every receipt. Write your exchange policy here in your own words."
  },
  {
   "fieldname": "receipt_terms_en",
   "fieldtype": "Small Text",
   "label": "Terms (English)"
  },
  {
   "fieldname": "permissions_section",
   "fieldtype": "Section Break",
   "label": "Permissions by role"
  },
  {
   "fieldname": "permissions_json",
   "fieldtype": "Code",
   "options": "JSON",
   "label": "Permission overrides (cashier / manager)",
   "description": "Edited by the System Manager only. Empty = defaults."
  },
  {
   "fieldname": "gift_design_section",
   "fieldtype": "Section Break",
   "label": "Gift card design (print sheet)"
  },
  {
   "fieldname": "gift_client_name",
   "fieldtype": "Data",
   "label": "Store name on the card"
  },
  {
   "fieldname": "gift_client_logo",
   "fieldtype": "Attach Image",
   "label": "Store logo",
   "description": "The Orbit mark is fixed on every card. Your logo goes beside it."
  },
  {
   "fieldname": "gift_color_1",
   "fieldtype": "Color",
   "label": "Card color",
   "default": "#12284C"
  },
  {
   "fieldname": "gift_color_2",
   "fieldtype": "Color",
   "label": "Second color",
   "default": "#1BA39C"
  },
  {
   "fieldname": "gift_accent",
   "fieldtype": "Color",
   "label": "Amount color",
   "default": "#F2A93B"
  },
  {
   "fieldname": "gift_terms_ar",
   "fieldtype": "Small Text",
   "label": "Card terms (Arabic, one per line)"
  },
  {
   "fieldname": "gift_terms_en",
   "fieldtype": "Small Text",
   "label": "Card terms (English)"
  }
 ],
 "permissions": [
  {
   "role": "POS Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "POS User",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ],
 "sort_field": "creation",
 "sort_order": "DESC",
 "track_changes": 0,
 "field_order": [
  "return_window_days",
  "allow_cross_branch_returns",
  "cashier_max_discount_percent",
  "cashier_cash_out_limit",
  "currency_per_point",
  "value_per_point",
  "barcode_prefix",
  "barcode_seq",
  "receipt_language",
  "ui_language",
  "default_theme",
  "eta_enabled",
  "eta_environment",
  "eta_note",
  "terms_section",
  "receipt_terms_ar",
  "receipt_terms_en",
  "permissions_section",
  "permissions_json",
  "gift_design_section",
  "gift_client_name",
  "gift_client_logo",
  "gift_color_1",
  "gift_color_2",
  "gift_accent",
  "gift_terms_ar",
  "gift_terms_en"
 ]
}